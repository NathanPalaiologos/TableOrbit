{
  "name": "tableorbit",
  "displayName": "TableOrbit",
  "description": "Read tables, explore panel data, and query local Parquet files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NathanPalaiologos/TableOrbit.git"
  },
  "homepage": "https://github.com/NathanPalaiologos/TableOrbit#readme",
  "bugs": {
    "url": "https://github.com/NathanPalaiologos/TableOrbit/issues"
  },
  "version": "0.2.0",
  "publisher": "tableorbit-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:panelSpace.openDemo",
    "onCommand:panelSpace.openCsv",
    "onCommand:panelSpace.openParquetFolder",
    "onCustomEditor:tableorbit.data",
    "onCommand:panelSpace.agentCLI"
  ],
  "contributes": {
    "configuration": {
      "title": "TableOrbit",
      "properties": {
        "panelSpace.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Full path to the Python executable. Parquet requires DuckDB. Figures require Matplotlib and Seaborn. Leave empty to use PANEL_SPACE_PYTHON, or python on PATH.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "panelSpace.openDemo",
        "title": "TableOrbit: Open Grunfeld Demo"
      },
      {
        "command": "panelSpace.openCsv",
        "title": "TableOrbit: Explore Data"
      },
      {
        "command": "panelSpace.openParquetFolder",
        "title": "TableOrbit: Open Parquet Dataset Folder"
      },
      {
        "command": "panelSpace.agentCLI",
        "title": "TableOrbit: Show Agent CLI Command"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "panelSpace.openCsv",
          "when": "resourceExtname =~ /\\.(parquet|csv|tsv|tab|txt|psv|json|jsonl|ndjson|xlsx|xlsm|feather|arrow|ipc|dta)$/i",
          "group": "navigation"
        },
        {
          "command": "panelSpace.openParquetFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tableorbit.data",
        "displayName": "TableOrbit",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "start": "node scripts/serve.cjs",
    "doctor": "node scripts/tableorbit.mjs doctor",
    "test": "node --test tests/data.test.mjs tests/reader.test.mjs tests/analysis.test.mjs tests/import.test.mjs tests/summary.test.mjs tests/interaction.test.mjs tests/detect.test.mjs tests/compose.test.mjs tests/flat.test.mjs tests/scanner.test.mjs tests/records.test.mjs",
    "stress": "node tests/stress.mjs",
    "package:check": "node scripts/package-check.mjs",
    "vscode:prepublish": "node scripts/package-check.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "test:flat": "node --test tests/flat.test.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "license": "MIT",
  "preview": true,
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "parquet",
    "panel data",
    "data viewer",
    "duckdb"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The local engine runs a configured Python executable."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Parquet queries require filesystem paths on the extension host."
    }
  },
  "files": [
    "extension.cjs",
    "scripts/scan.cjs",
    "scripts/scan_file.py",
    "scripts/figure.cjs",
    "scripts/render_figure.py",
    "web/index.html",
    "web/style.css",
    "web/analysis.mjs",
    "web/app.mjs",
    "web/compose.mjs",
    "web/composer.mjs",
    "web/data.mjs",
    "web/detect.mjs",
    "web/figures.mjs",
    "web/flat.mjs",
    "web/i18n.mjs",
    "web/import.mjs",
    "web/interaction.mjs",
    "web/limits.mjs",
    "web/reader.mjs",
    "web/scanner.mjs",
    "web/time.mjs",
    "web/data/grunfeld.csv",
    "web/data/gapminder.tsv",
    "web/data/nlswork.csv",
    "requirements-engine.txt",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "CHANGELOG.md",
    "docs/LAZY_FILES.md",
    "docs/EVENT_VALIDATION.md",
    "docs/RELEASE.md",
    "docs/IMPORT_DETECTION.md",
    "docs/MULTITABLE_CONNECTIONS.md",
    "docs/INTERACTION_DESIGN.md",
    "docs/STRESS_TEST.md",
    "docs/PARQUET_VALIDATION.md",
    "web/toolbar.mjs",
    "docs/ROADMAP.md",
    "scripts/lazy_queries.py",
    "scripts/tableorbit.mjs",
    "scripts/serve.cjs",
    "docs/AGENT_CLI.md",
    "docs/INSTALL.md",
    "docs/QUICK_START.md",
    "docs/USER_GUIDE.md",
    "docs/WRITING.md",
    "docs/VSIX_LOCAL_TEST.md",
    "docs/images/vscode-reader.jpg",
    "docs/images/vscode-series.jpg",
    "docs/images/vscode-figure.jpg",
    "docs/images/vscode-install.jpg",
    "docs/images/vscode-explorer.jpg",
    "docs/images/README.md",
    "web/records.mjs",
    "scripts/files.cjs",
    "scripts/read_table.py",
    "docs/OPEN_FILES.md",
    "docs/images/browser-start.jpg"
  ],
  "bin": {
    "tableorbit": "./scripts/tableorbit.mjs"
  }
}
